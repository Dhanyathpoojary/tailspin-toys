---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher !== null)
    .map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form
            class="mb-8 grid gap-4 rounded-xl border border-slate-700 bg-slate-800/60 p-6 sm:grid-cols-2"
            data-testid="game-filters"
          >
            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="category-filter">
                Categories
              </label>
              <select
                id="category-filter"
                name="category"
                multiple
                size={Math.min(Math.max(categories.length, 2), 5)}
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="category-filter"
              >
                {categories.map((category) => (
                  <option value={category.id}>{category.name}</option>
                ))}
              </select>
              <p class="mt-2 text-xs text-slate-400">
                Hold Ctrl (Windows) or Command (Mac) to choose more than one.
              </p>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="publisher-filter">
                Publisher
              </label>
              <select
                id="publisher-filter"
                name="publisher"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </div>

            <button
              type="button"
              class="w-fit rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </form>

          <p class="mb-4 text-sm text-slate-400" aria-live="polite" data-testid="filter-results">
            Showing {games.length} games
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden" data-testid="filtered-empty">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const resultSummary = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];

  const updateFilters = (): void => {
    const selectedCategories = new Set(
      [...(categoryFilter?.selectedOptions ?? [])].map((option) => option.value),
    );
    const selectedPublisher = publisherFilter?.value ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const matchesCategory =
        selectedCategories.size === 0 ||
        selectedCategories.has(card.dataset.gameCategoryId ?? '');
      const matchesPublisher =
        selectedPublisher === '' ||
        card.dataset.gamePublisherId === selectedPublisher;
      const isVisible = matchesCategory && matchesPublisher;

      card.hidden = !isVisible;
      visibleCount += isVisible ? 1 : 0;
    }

    if (resultSummary) {
      resultSummary.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
    }
    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  };

  filterForm?.addEventListener('change', updateFilters);
  clearFilters?.addEventListener('click', () => {
    if (categoryFilter) {
      for (const option of categoryFilter.options) {
        option.selected = false;
      }
    }
    if (publisherFilter) {
      publisherFilter.value = '';
    }
    updateFilters();
  });
</script>
